# --- API ---
DATABASE_URL=postgres://rideloc:rideloc_dev_password@127.0.0.1:5432/rideloc
# Wajib >= 32 karakter. Buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Opsional (nilai default ditampilkan):
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:5173
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
# --- Routing & tarif (Fase 2), semuanya opsional ---
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_MS=2000
# MAX_TRIP_KM=100
# ESTIMATE_RATE_LIMIT_MAX=30
# Override tarif (integer rupiah, kedua jenis kendaraan wajib ada), satu baris:
# PRICING_JSON={"MOTORCYCLE":{"base":2000,"perKm":2500,"perMinute":200,"minimum":8000},"CAR":{"base":5000,"perKm":4000,"perMinute":400,"minimum":15000}}
# --- Matching (Fase 4), semuanya opsional ---
# MATCH_OFFER_TTL_S=15
# MATCH_SEARCH_TIMEOUT_S=30
# MATCH_TICK_MS=1000